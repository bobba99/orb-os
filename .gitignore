# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Build artifacts
*.bin
*.elf
*.map
build/
dist/

# Secrets (WiFi creds live in NVS on the device, never in the repo)
secrets.h

# ESP-IDF (stage 2 of REWRITE_PLAN.md). CMakeLists.txt and dependencies.lock ARE source
# now: the lock file is what pins every managed component to an exact version. What the
# build generates is not: the full sdkconfig is derived from sdkconfig.defaults, and
# managed_components/ is downloaded from the lock.
managed_components/
sdkconfig
sdkconfig.old
.dummy/

# Generated staging trees, not source
sdcard_stage/
sim/
data/

# Working asset dumps (source of truth is elsewhere; too large/churny for git)
tools/data/
tools/hands/

# Watch-script runtime state
orb_watch.log
orb_watch.pid

# Theme bundles and their expansions.
#
# .orb files are Orb Studio build output, and themes/unpacked/ is derived from them by
# tools/read-orb-bundle.py's sibling unpacker — neither is source. Five bundles plus their
# contents is ~26 MB of PNG and PCM that would otherwise land in a commit via `git add .`.
themes/*.orb
themes/unpacked/
